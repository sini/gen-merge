    set = "the operation takes its argument as an attribute set and selects from it without asking its domain first, so a non-set reaches the interpreter: `expected a set but found …`, naming neither the operation nor the input. Disposition: den-hoag-jmwbf.";
    assertion = "a bare `assert` guards the argument. It is catchable, but it refuses with the interpreter's `assertion … failed`, which names no library and no operation, and the item asks for a NAMED refusal. Disposition: den-hoag-jmwbf.";
    json = "the fold serialises a value carrying a function (`builtins.toJSON`) to render it, and aborts `cannot convert a function to JSON` instead of refusing the definition by name. Disposition: den-hoag-jmwbf.";
    call = "the operation applies a value it never checked is callable: `attempt to call something which is not a function`. Disposition: den-hoag-jmwbf.";
    string = "the operation interpolates its argument's elements as strings without asking their domain: `expected a string but found …`. Disposition: den-hoag-jmwbf.";
